# Copy this file to `.env` and fill in real values. `.env` is already
# in .gitignore -- never commit real API keys to the repository.

# ---------------------------------------------------------------------------
# Chatbot LLM (backend/app.py -> src/chatbot/llm_client.py)
# ---------------------------------------------------------------------------

# Required for the chatbot to use a real model instead of mock replies.
# Without this set, the app runs normally -- the chatbot just returns
# sample replies instead of calling a paid API. Every other feature
# (Privacy Guard, file/Telegram analysis, speech-to-text) works fully
# without this key.
OPENAI_API_KEY=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
# Which chat model to use. Change this anytime without touching any
# code -- e.g. if a cheaper or newer model becomes available.
OPENAI_CHAT_MODEL=gpt-5.6-luna

# Optional. Leave unset to use OpenAI directly. Set this to point at
# any OpenAI-compatible endpoint instead -- for example Google Gemini's
# OpenAI-compatible endpoint:
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional. Caps the length (and therefore cost) of each chatbot
# reply. Defaults to 500 if not set.
OPENAI_MAX_REPLY_TOKENS=500

# Optional. Lower = steadier, more consistent tone (recommended for a
# safety-adjacent product). Defaults to 0.3 if not set. Range is 0-2.
OPENAI_TEMPERATURE=0.3

# Optional. Request timeout in seconds. Defaults to 300 if not set.
OPENAI_TIMEOUT_SECONDS=300
